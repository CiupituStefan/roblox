# Copiază acest fișier în ".env" și completează valorile.

# Cheia secretă partajată cu Roblox (generează: npm run genkey).
# ACEEAȘI valoare o pui în Roblox Secrets Store sub numele TIKTOK_RELAY_KEY.
RELAY_KEY=

# Portul local pe care ascultă relay-ul (Cloudflare Tunnel îl expune pe HTTPS)
PORT=8787

# Sursa evenimentelor TikTok: tikfinity | connector | none
#   tikfinity -> aplicația TikFinity deschisă pe același PC (WebSocket local)
#   connector -> biblioteca tiktok-live-connector (npm i tiktok-live-connector)
#   none      -> doar simulare (pentru teste)
SOURCE=tikfinity
TIKFINITY_WS_URL=ws://localhost:21213/

# Doar pentru SOURCE=connector: username-ul TikTok al LIVE-ului tău (fără @)
TIKTOK_USERNAME=

# Comenzi din chat (separate prin virgulă)
JOIN_COMMANDS=!join,!intra,!race
VERIFY_COMMANDS=!verify,!verifica

# Verificarea proprietății contului Roblox (cod pus în descrierea profilului)
#   false -> oricine se poate înscrie; conturile verificate sunt protejate
#   true  -> doar conturile verificate se pot înscrie
REQUIRE_VERIFICATION=false

# Permite POST /simulate (teste fără TikTok). Pune false în LIVE dacă nu ai nevoie.
ALLOW_SIMULATE=true

# Cât timp e păstrat un eveniment pentru reluare când serverul Roblox repornește
GIFT_REPLAY_MAX_AGE_MS=20000
JOIN_REPLAY_MAX_AGE_MS=600000
